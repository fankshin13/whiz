# 앱에는 공개 가능한 Supabase 클라이언트 접속 정보만 넣는다. 서버 비밀 키는 절대 넣지 않는다.
# 사용법: cp .env.example .env 후 값 채우기 → flutter run --dart-define-from-file=.env
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# 초대 검증·수락 API 를 제공하는 웹 콘솔 주소(끝에 / 없이)
WEB_API_BASE_URL=https://your-pedaleye-web-console.example
