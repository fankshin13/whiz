{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "regions": [
    "icn1"
  ],
  "ignoreCommand": "[ \"$VERCEL_ENV\" = \"preview\" ]",
  "crons": [
    {
      "path": "/api/cron/audit-retention",
      "schedule": "10 18 1 * *"
    }
  ]
}
