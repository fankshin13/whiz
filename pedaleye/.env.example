# 이름만 적습니다. 실제 값은 .env.local에 넣고 커밋하지 마세요.

# Supabase (클라이언트 공개)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase 서버 전용 시크릿 (lib/server/env.ts 에서만 읽음)
SUPABASE_SERVICE_ROLE_KEY=

# 기준 시간대 (권장: Asia/Seoul)
NEXT_PUBLIC_APP_TIMEZONE=

# NTP 동기화 호스트 (권장: time.google.com)
NTP_SERVER_HOST=

# 사고 전후 버퍼 시간(초) (기본: 30)
EVENT_BUFFER_WINDOW_SEC=

# 초대 링크 등 외부 전달 URL 의 기준 주소 (예: https://console.example.com)
APP_BASE_URL=

# Vercel Cron 인증 값(16자 이상, 비우면 감사 로그 자동 정리가 꺼짐)
CRON_SECRET=

# 자동 작업 결과를 받는 감시 서비스 핑 주소(https, 선택. 예: https://hc-ping.com/<uuid>)
CRON_HEARTBEAT_URL=

# 개인정보처리방침(/privacy) 게시 정보. 넷 다 있어야 공개된다
PRIVACY_CONTROLLER=
PRIVACY_OFFICER=
PRIVACY_CONTACT=
PRIVACY_EFFECTIVE_DATE=
